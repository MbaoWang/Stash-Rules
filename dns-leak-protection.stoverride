name: DNS 防洩漏
desc: DNS 分流：中國網域用阿里 DoH 直連，其餘用 Cloudflare / Google DoH 並經 PROXY 送出（DNS 跟著節點所在地），阻擋繞過 Stash 的明文 DNS / DoT
# 策略組：PROXY（若你的配置名稱不同，請把下方規則裡的 PROXY 一併修改，名稱不存在時 Stash 會載入失敗）

dns:
  # ── 1. Stash 自己發出的 DNS 查詢也要比對規則
  #    配合下方規則，國外 DoH 會經 PROXY 送出：DNS 伺服器看到的是節點 IP，
  #    回應的也是節點所在地的 DNS 節點，所以就算本地解析，檢測結果也會顯示節點所在地
  follow-rule: true

  # ── 2. 引導 DNS：只用來解析節點的網域（直連）
  #    必須和下面阿里的 223.5.5.5 分開，且不能被規則導向 PROXY，否則解析節點又要經過節點，形成迴圈
  default-nameserver: #!replace
    - https://223.6.6.6/dns-query
  proxy-server-nameserver: #!replace
    - https://223.6.6.6/dns-query

  # ── 3. 國外 / 未分類網域：Cloudflare + Google DoH（經 PROXY）
  #    Stash 會「同時」查詢所有 nameserver，用最先回來的結果；
  #    用 #!replace 整個取代，否則原本的 ISP DNS 仍會收到查詢
  #    全部寫成 IP，不需要先解析 DoH 伺服器的網域
  nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  # ── 4. 清掉原配置的 fallback，避免舊的 DNS 仍被查詢
  fallback: #!replace
    []

  # ── 5. 中國網域：阿里 DoH（直連，解析出國內最近的 CDN 節點）
  #    #!replace 會取代原配置的 nameserver-policy
  nameserver-policy: #!replace
    'geosite:cn':
      - https://223.5.5.5/dns-query

rules:
  # ── 6. DoH 伺服器的出口：國外走 PROXY，阿里直連
  - AND,((DST-PORT,443),(IP-CIDR,1.1.1.1/32,no-resolve)),PROXY
  - AND,((DST-PORT,443),(IP-CIDR,8.8.8.8/32,no-resolve)),PROXY
  - AND,((DST-PORT,443),(IP-CIDR,223.5.5.5/32,no-resolve)),DIRECT
  - AND,((DST-PORT,443),(IP-CIDR,223.6.6.6/32,no-resolve)),DIRECT

  # ── 7. 阻擋 App 自己寫死的明文 DNS（53）和 DoT（853），迫使它改走 Stash 的 DNS
  #    系統一般的 DNS 查詢由 Stash DNS 直接處理，不會進規則，不受影響
  - DST-PORT,53,REJECT
  - DST-PORT,853,REJECT
