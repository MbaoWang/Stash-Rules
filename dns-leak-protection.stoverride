name: 'DNS 防洩漏'
desc: '國外 DNS 經指定出口送出（DNS 跟著節點所在地），中國網域用國內 DoH 直連；DNS 伺服器自動選最快的。需要 Stash 3.7 以上。'
category: '網路隱私'
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Stash.png'
openUrl: 'https://stash.wiki/features/dns-server'
homepage: 'https://github.com/MbaoWang/Stash-Rules'

# ============================================================
# 參數：安裝或編輯覆寫時，Stash 會顯示這些選項
# ============================================================
arguments-version: 1
arguments:
  egress:
    type: input
    title: 'DNS 出口（必填）'
    description: '國外 DNS 查詢要走的策略組或節點名稱，通常填 PROXY。要和配置裡的名稱一字不差；不能填 DIRECT，也不能填最後會走 DIRECT 的組。'
    required: true
    min-length: 1
  bootstrap:
    type: select
    title: '引導 DNS'
    description: '只用來查「節點網域」的 IP，一律直連，網站的查詢不會交給它。人在中國請用阿里或 DNSPod；國外 DNS 在中國常連不通，會導致節點解析失敗、整個 VPN 起不來。'
    default: '223.6.6.6'
    options:
      - {value: '223.6.6.6', label: '阿里 223.6.6.6 · 中國可用（預設）'}
      - {value: '223.5.5.5', label: '阿里 223.5.5.5 · 中國可用'}
      - {value: '1.12.12.12', label: 'DNSPod 1.12.12.12 · 中國可用'}
      - {value: '120.53.53.53', label: 'DNSPod 120.53.53.53 · 中國可用'}
      - {value: '1.0.0.1', label: 'Cloudflare 1.0.0.1 · 中國以外'}
      - {value: '8.8.4.4', label: 'Google 8.8.4.4 · 中國以外'}
      - {value: '185.222.222.222', label: 'DNS.SB 185.222.222.222 · 中國以外'}

dns:
  # ── 1. Stash 自己發出的 DNS 查詢也要比對規則
  #    配合下方規則，國外 DoH 會經「DNS 出口」送出：DNS 伺服器看到的是節點 IP，
  #    回應的也是節點所在地的 DNS 節點，所以就算本地解析，檢測結果也會顯示節點所在地
  follow-rule: true

  # ── 2. 引導 DNS：只用來解析「節點」的網域，一律直連
  #    如果它也走代理，就會變成「要連節點得先解析節點」的迴圈
  default-nameserver: #!replace
    - 'https://${args.bootstrap}/dns-query'
  proxy-server-nameserver: #!replace
    - 'https://${args.bootstrap}/dns-query'

  # ── 3. 國外 / 未分類網域：Cloudflare + Google（自動選擇）
  #    Stash 會「同時」查詢所有 nameserver，用最先回來的結果
  #    - IP 寫法：固定用 IPv4 連
  #    - 網域寫法：交給節點解析，節點有 IPv6 就可能用 IPv6 連
  #    用 #!replace 整個取代，否則原本的 ISP DNS 仍會收到查詢
  nameserver: #!replace
    - 'https://1.1.1.1/dns-query'
    - 'https://8.8.8.8/dns-query'
    - 'https://cloudflare-dns.com/dns-query'
    - 'https://dns.google/dns-query'

  # ── 4. 清掉原配置的 fallback，避免舊的 DNS 仍被查詢
  fallback: #!replace
    []

  # ── 5. 中國網域：阿里 + DNSPod（自動選擇，直連，解析出國內最近的 CDN 節點）
  #    #!replace 會取代原配置的 nameserver-policy
  nameserver-policy: #!replace
    'geosite:cn':
      - 'https://223.5.5.5/dns-query'
      - 'https://223.6.6.6/dns-query'
      - 'https://1.12.12.12/dns-query'

rules:
  # ── 6. 引導 DNS 一律直連，放在最前面
  #    選 Google 8.8.4.4 時，它也是 dns.google 的 IP 之一，必須先命中這條直連，否則會被下面導向代理而形成迴圈
  - 'AND,((DST-PORT,443),(IP-CIDR,${args.bootstrap}/32,no-resolve)),DIRECT'

  # ── 7. 國外 DoH 走「DNS 出口」（網域與它們的 IPv4 / IPv6 都列出，不論 Stash 用哪種方式連都會命中）
  - 'AND,((DST-PORT,443),(DOMAIN,cloudflare-dns.com)),${args.egress}'
  - 'AND,((DST-PORT,443),(DOMAIN,dns.google)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR,1.1.1.1/32,no-resolve)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR,8.8.8.8/32,no-resolve)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR,8.8.4.4/32,no-resolve)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR,104.16.248.249/32,no-resolve)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR,104.16.249.249/32,no-resolve)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR6,2606:4700::6810:f8f9/128,no-resolve)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR6,2606:4700::6810:f9f9/128,no-resolve)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR6,2001:4860:4860::8888/128,no-resolve)),${args.egress}'
  - 'AND,((DST-PORT,443),(IP-CIDR6,2001:4860:4860::8844/128,no-resolve)),${args.egress}'

  # ── 8. 直連的 DoH：中國網域的阿里與 DNSPod
  - 'AND,((DST-PORT,443),(IP-CIDR,223.5.5.5/32,no-resolve)),DIRECT'
  - 'AND,((DST-PORT,443),(IP-CIDR,223.6.6.6/32,no-resolve)),DIRECT'
  - 'AND,((DST-PORT,443),(IP-CIDR,1.12.12.12/32,no-resolve)),DIRECT'

  # ── 9. 阻擋 App 自己寫死的明文 DNS（53）和 DoT（853），迫使它改走 Stash 的 DNS
  #    系統一般的 DNS 查詢由 Stash DNS 直接處理，不會進規則，不受影響
  - 'DST-PORT,53,REJECT'
  - 'DST-PORT,853,REJECT'
