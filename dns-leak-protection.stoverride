name: DNS 防洩漏
desc: DNS 分流：中國網域用阿里 DoH，其餘用 Cloudflare / Google DoH，並阻擋繞過 Stash 的 DoT

dns:
  # ── 1. 引導 DNS：只用來解析下面 DoH 伺服器本身的網域（dns.alidns.com、dns.google）
  #    用 #!replace 整個取代原配置，不放 system，避免 ISP DNS 收到查詢
  default-nameserver: #!replace
    - 223.5.5.5
    - 223.6.6.6

  # ── 2. 國外 / 未分類網域：Cloudflare + Google DoH
  #    Stash 會「同時」查詢所有 nameserver，所以要用 #!replace，否則原本的 ISP DNS 仍會收到查詢
  nameserver: #!replace
    - https://1.1.1.1/dns-query
    - https://dns.google/dns-query

  # ── 3. 中國網域：阿里 DoH（解析出國內最近的 CDN 節點）
  #    #!replace 會取代原配置的 nameserver-policy
  nameserver-policy: #!replace
    'geosite:cn':
      - https://dns.alidns.com/dns-query
      - https://223.5.5.5/dns-query

rules:
  # ── 4. 阻擋 App 自己用 DoT（853 埠）直連 DNS 伺服器，迫使它改走 Stash 的 DNS
  - DST-PORT,853,REJECT
